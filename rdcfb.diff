+void SetPolarity(UCHAR DevicePort, UCHAR Value)
+{
+    Value ^= BIT2+BIT1; 
+    
+    switch (DevicePort)
+    {
+        case CRT_PORT:
+            OutPort(MISC_WRITE, ((Value<<5) & 0xC0) | (InPort(MISC_READ) & 0x3F));
+            break;
+        
+        case DVP1:
+        case DVP12:
+            SetSRReg(0x20, Value>>1, BIT1+BIT0);
+            break;
+
+        case DVP2:
+            SetSRReg(0x20, Value<<2, BIT4+BIT3);
+            break;
+    }
+}
