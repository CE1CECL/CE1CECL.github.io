+    } while (0)
+    
+#define SetIndexRegMask(base,index, and, val)   \
+    do {                                        \
+        u8 __Temp;                           \
+        outb(index, par->usrio + base);                       \
+         __Temp = (inb((par->usrio + base)+1)&(and))|(val);  \
