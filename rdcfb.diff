+void ConfigDigitalPort(UCHAR bDisplayPath)
+{
+    PORT_CONFIG *pDevicePortConfig;
+    UCHAR bDeviceIndex;
+    UCHAR bRegValue;
+
+    bDeviceIndex = Get_DEV_ID(bDisplayPath);
