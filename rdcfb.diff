+static __inline__ char* get_opt_string(const char *opt, const char *name)
+{
+    const char *p;
+    int i;
+    char *ret = NULL;
+
+    p = opt + strlen(name);
+    i=0;
+
+    while(p[i] && p[i]!=',' && p[i]!=' ')
+        i++;
+
+    ret = kmalloc(i+1, GFP_KERNEL);
+
+    if (ret)
+    {
+        strncpy(ret,p,i);
+        ret[i]='\0';
+    }
+    return ret;
+}
