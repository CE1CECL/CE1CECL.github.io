+    PRINTK(KERN_INFO "Port Config = %x\n", (int)pPortConfig);
+    
+    ParseTable("VPIT", (UCHAR*)pCBiosArguments->reg.ex._ECX, (UCHAR**)(&pVESATable));
+    PRINTK(KERN_INFO "VESA Table = %x\n", (int)pVESATable);
