+void SetColorDepth(UCHAR DisplayPath, UCHAR Value)
+{
+    UCHAR bSetBit = 0x0;
+
+    switch(Value)
+    {
+        case 8:
+            bSetBit = (UCHAR)BIT0;
+            break;
+        case 16:
+            bSetBit = (UCHAR)BIT2;
+            break;
+        case 32:
+            bSetBit = (UCHAR)BIT3;
+            break;
+        default:
+            return;
+    }
+
+    if(DisplayPath == DISP1)
+    {
+        SetCRReg(0xA3, bSetBit, 0x0F);
+    }
+    else
+    {
+        
+        if(Value == 8)
+            return;
+        
+        SetCRReg(0x33, bSetBit, 0x0F);
+    }
+    
+}
