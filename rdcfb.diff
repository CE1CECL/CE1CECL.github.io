+    MODE_INFO   *pModeInfo = NULL;
+    UCHAR    bColorDepth = 0;
+    UCHAR    bCurDeviceID, bNewDeviceID;
+
+    PRINTK(KERN_INFO "==Entry VBE_SetMode Mode number 0x%x== \n",wModeNum);
+
+    if (wModeNum < 0x100)
+    {
+        SetVBERerurnStatus(VBEFunctionCallFail, &pCBIOSExtension->CBiosArguments);
+        return ci_true;
