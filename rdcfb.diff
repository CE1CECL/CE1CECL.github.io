+UCHAR GetPortConnectPath(UCHAR PortType)
+{
+    UCHAR SR1F, PortMask = 0;
+
+    SR1F = GetSRReg(0x1F);
+    SR1F ^= 0x03;
+    
+    switch(PortType)
+    {
+        case CRT_PORT:
+            PortMask = BIT2;
+            break;
+            
+        case DVP1:
+        case DVP12:
+            PortMask = BIT0;
+            break;
+            
+        case DVP2:
+            PortMask = BIT1;
+            break;
+    }
+    
+    return ((SR1F & PortMask) ? 1 : 0);
+
+}
