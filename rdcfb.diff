+void PowerSequenceOn()
+{
+    
+    if (!(GetSRReg(0x11) & BIT0))
+    {
+        
+        SetSRReg(0x32, BIT1, BIT1);
+        
+        
+        SetSRReg(0x11, BIT0, BIT0);
+        
+        
+        WaitPowerSequenceDone();
+    }
+}
+
+void PowerSequenceOff()
+{
+    
+    if (GetSRReg(0x11) & BIT0)
+    {
+        
+        SetSRReg(0x11, 0, BIT0);
+        
+        
+        WaitPowerSequenceDone();
+        
+        
+        SetSRReg(0x32, 0, BIT1);
+    }
+}
