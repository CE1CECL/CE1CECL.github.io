+    }
+    else
+    {
+        bRegValue = 0x4;
+    }
+
+    if (GetDevicePortConfig(bDeviceIndex, &pDevicePortConfig))
+    {
+        switch(pDevicePortConfig->PortID)
+        {
+            case CRT_PORT:
+                SetSRReg(0x1F, bRegValue, BIT2);
+                break;
+                
+            case DVP1:
+                Set12BitDVP();
+                SetSRReg(0x1F, bRegValue, BIT0);
+                break;
+                
+            case DVP2:
+                Set12BitDVP();
+                SetSRReg(0x1F, bRegValue, BIT1);
+                break;
+                
+            case DVP12:
